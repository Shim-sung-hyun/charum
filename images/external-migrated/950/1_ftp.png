        function sendPageInfo() {
          if (!chatIframe.contentWindow) return;
          chatIframe.contentWindow.postMessage({
            type: 'PARENT_PAGE_INFO',
            referrer: document.referrer,
            href: location.href,
            search: location.search
          }, '*');
        }

        chatIframe.addEventListener('load', sendPageInfo);
        if (chatIframe.contentDocument && chatIframe.contentDocument.readyState === 'complete') {
          sendPageInfo();
        }
      })();
    </script>

