<script>


    $(document).ready(function() {
        const pathSegments = window.location.pathname.split('/');
        
        $(".widget_main_menu li").each(function() {
            const listItem = $(this);
            const listItemUrl = listItem.data('url');
            if (listItemUrl === pathSegments[1]) {
                listItem.addClass('active');
                $(".new_widget .sub_menu ul").hide();
                $(".new_widget .sub_menu ul[data-set='" + pathSegments[1] + "']").show();
                $(".new_widget .sub_menu ul[data-set='" + pathSegments[1] + "'] li").each(function() {
                    const listItem2 = $(this);
                    const listItemUrl2 = listItem2.data('url');
                    const listItemEndpoint = listItem2.data('endpoint');

                    if (listItemUrl2 == pathSegments[2] && listItemEndpoint == pathSegments[3]) {
                        listItem2.addClass('active');
                    } else {
                        listItem2.removeClass('active');
                    }
                });

            } else if(pathSegments[1] == 'member'){
                $(".new_widget .sub_menu ul[data-set='member']").show();
                $(".new_widget .sub_menu").offset({ top: 240 });
            } else {
                listItem.removeClass('active');
            }
        });


        function setSubMenuTop(item) {
            if (item.length != 0){
                const itemTop = item.offset().top;
                const itemUrl = item.data('url');
                $(".new_widget .sub_menu").offset({ top: itemTop });
                $(".new_widget .sub_menu ul").hide();
                $(".new_widget .sub_menu ul[data-set='" + itemUrl + "']").show();
            }
        }

        $(".widget_main_menu li").mouseover(function() {
            setSubMenuTop($(this));
        });


        setSubMenuTop($(".widget_main_menu li.active"));

    });


    $(".profile").on('click',()=>{location.href="/member/payment"})

    function handleMenu(action) {
        if(action === 'closer') {
            $('.new_widget').addClass('closers');
            $(".widget_main_menu").slideUp();
            $(".customer_center").slideUp();
            $(".new_widget .sub_menu").slideUp();
            $('.new_widget').removeClass('full');
            setTimeout(()=>{$(".right_menu").removeClass('open');},300)
            
        } else if(action === 'middle') {
            $('.new_widget').removeClass('closers');
            $(".widget_main_menu").slideDown();
            $(".customer_center").slideDown();
            $(".new_widget .sub_menu").slideDown();
            $('.new_widget').removeClass('full');
            setTimeout(()=>{$(".right_menu").removeClass('open');},300)
        } else if(action === 'full') {
            $('.new_widget').removeClass('closers');
            $(".widget_main_menu").slideDown();
            $(".customer_center").slideDown();
            $(".new_widget .sub_menu").hide();
            $(".right_menu").addClass('open');
            $('.new_widget').addClass('full');
            $('.widget_guide').hide();
        }
    }

    $(".mod_change").on('click', '.closer', function() {
        handleMenu('closer');
    });

    $(".mod_change").on('click', '.middle', function() {
        handleMenu('middle');
    });

    $(".mod_change").on('click', '.full', function() {
        handleMenu('full');
    });

    $(".sub_menu_01").each( (k,v)=> {
        $(v).on('click',()=>{
            $(v).children("ul").toggleClass('active');
        })
    
})


$(".dotbots").on('click',()=>{
    $(".dotbot").slideDown().show();
    chatbot();
})

$(".naver").on('click',()=>{
    window.open('https://talk.naver.com/ct/wcdvg5', '_blank');
})



$(document).ready(function() {
    // 초기 실행
    checkResolution();

    // 창 크기가 변경될 때마다 실행
    $(window).resize(function() {
        checkResolution();
    });
});

function checkResolution() {
    var screenWidth = $(window).width();
    
    // 해상도가 1730px 미만인 경우
    if (screenWidth < 1730) {
        handleMenu('closer');
    } 
    // 그 외의 경우
    else {
        handleMenu('middle');
    }
}

$(document).ready(function() {
    var lastVisit = localStorage.getItem('lastVisit');

    if (!lastVisit) {
        $('.widget_guide').show();
    } else {
        var now = new Date().getTime();
        var elapsedHours = (now - lastVisit) / (1000 * 60 * 60);

        if (elapsedHours >= 24) {
            $('.widget_guide').show();
        } else {
            $('.widget_guide').hide();
        }
    }
    localStorage.setItem('lastVisit', new Date().getTime());

    $(".guide_open").click(function() {
        $('.widget_guide').toggle();
    });
    
});
</script>

